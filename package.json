{
  "name": "@composa/ui",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Composa editor UI — merged component set (UI3 primitives + Composa panels). Consumed by composa-editor.",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/index.css",
    "./editor-bridge.css": "./src/styles/editor-bridge.css"
  },
  "main": "./src/index.ts",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vite build",
    "tokens:build": "node tools/tokens/build-json.mjs",
    "tokens:check": "node tools/tokens/verify-parity.mjs",
    "check": "npm run tokens:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-tooltip": "1.1.8",
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "4.7.0",
    "react-test-renderer": "^19.2.0",
    "tailwindcss": "4.1.12",
    "typescript": "5.6.3",
    "vite": "6.3.5",
    "vitest": "3.2.7"
  }
}
